scr_v2_fight_log("DISPLAY: requestedFullscreen="+string(global.v2_fight_fullscreen)+" actualFullscreen="+string(window_get_fullscreen())+" requested="+string(global.v2_fight_requested_w)+"x"+string(global.v2_fight_requested_h)+" render="+string(global.resolutionW)+"x"+string(global.resolutionH)+" window="+string(window_get_width())+"x"+string(window_get_height())+" desktop="+string(display_get_width())+"x"+string(display_get_height())+" scale="+string(global.gameScale)+" logical="+string(global.resolutionW/global.gameScale)+"x"+string(global.resolutionH/global.gameScale));
if(window_get_fullscreen()==global.v2_fight_fullscreen && global.resolutionW/global.gameScale>=640 && global.resolutionH/global.gameScale>=360)scr_v2_fight_log("PASS: requested display mode and logical dimensions");else scr_v2_fight_log("FAIL: requested display mode or logical dimensions");
