// Workshop credits added under Information > System (after the game's own credits).
// Set-Credits.ps1 fills in the names. "#" starts a new line in Kingsway text.
var q=chr(34);var t="";
t+="##Enemy Mod API:   Dippo Dust Aisle; using Astra 6.";
t+="##Enemy Mod menu:   Dippo Dust Aisle; using Opus 5.5, Astra 6.";
t+="##Cosmetic Menu Sprites:   Dippo Dust Aisle";
t+="##Sprites for "+q+"Draggable"+q+", blue/red "+q+"Pin"+q+" icons:   Dippo Dust Aisle";
t+="##Optimizations:   Opus 5.5";
return t;
